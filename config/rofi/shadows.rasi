/* DarkShadow's Shell rofi theme. Generated by rice-rofi, edit it in Settings > Rofi. */
configuration {
    show-icons: true;
    drun-display-format: "{name}";
}

* {
    bg: #0d0d0d8f;
    alt: #1a1a1aa3;
    fg: #F6F5F4;
    dim: #8a8a8a;
    sel: #F6F5F4;
    selfg: #0d0d0d;
    bd: #ffffff1a;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    location: center;
    anchor: center;
    y-offset: 0px;
    width: 620px;
    border-radius: 18px;
    background-color: @bg;
    border: 1px;
    border-color: @bd;
    padding: 0px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
    padding: 14px;
    background-color: transparent;
}

inputbar {
    children: [ entry ];
    padding: 10px 16px;
    border-radius: 12px;
    background-color: @alt;
}

entry {
    placeholder: "Search";
    placeholder-color: @dim;
    text-color: @fg;
    background-color: transparent;
    cursor-color: @fg;
}

prompt {
    enabled: false;
}

listview {
    columns: 1;
    lines: 8;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
    background-color: transparent;
}

element {
    orientation: horizontal;
    padding: 8px 12px;
    border-radius: 12px;
    spacing: 12px;
    background-color: transparent;
    text-color: @fg;
}

element normal.normal, element alternate.normal, element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @fg;
}

element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: #ff6b6b;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @sel;
    text-color: @selfg;
}

element-icon {
    size: 28px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

scrollbar {
    enabled: false;
}

message {
    background-color: transparent;
    padding: 4px 8px;
}

textbox {
    text-color: @fg;
    background-color: transparent;
}
