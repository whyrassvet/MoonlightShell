configuration {
    modes: "drun";
    sorting-method: "normal";
    show-icons: true;
    matching: "regex";
    drun-match-fields: "name";
    display-run: "menu:";
    display-drun: "Launch:";
}

* {
    font: "JetBrains Mono 11";
    background-color: transparent;
    text-color: #6C6C6D;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 500;
    y-offset: -20;

    border-radius: 12px;
    border: 0px;

    background-color: #0d0d0d99;
}

mainbox {
    padding: 8px;
    background-color: transparent;
}

inputbar {
    background-color: #1a1a1acc;
    border-radius: 6px;
    border: 0px;

    padding: 8px 12px;
    spacing: 8px;
}

prompt {
    text-color: #B0B0B2;
    background-color: transparent;
}

entry {
    text-color: #6C6C6D;
    placeholder: "search";
    placeholder-color: #6C6C6D;
    background-color: transparent;
}

listview {
    background-color: transparent;
    margin: 8px 0 0;

    columns: 1;
    lines: 6;
    fixed-height: false;
}

/* ===== Elements ===== */
element {
    padding: 8px 10px;
    spacing: 6px;
    border-radius: 6px;
}

element normal.normal {
    background-color: transparent;
    text-color: #6C6C6D;
}

element alternate.normal {
    background-color: transparent;
    text-color: #6C6C6D;
}

element normal.urgent {
    background-color: #2a2a2a;
    text-color: #B0B0B2;
}

element normal.active {
    background-color: transparent;
    text-color: #6C6C6D;
}

element selected.normal,
element selected.active {
    background-color: #1a1a1acc;
    text-color: #B0B0B2;
}

element selected.urgent {
    background-color: #2a2a2a;
    text-color: #B0B0B2;
}

element-icon {
    size: 1em;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    text-color: inherit;
    background-color: transparent;
}

message {
    margin: 8px 0 0;
    border-radius: 8px;
    border: 0px;

    background-color: transparent;
}

textbox {
    padding: 8px 16px;
    background-color: transparent;
}
/* rice-rofi */ @theme "@HOME@/.config/rofi/shadows.rasi"
