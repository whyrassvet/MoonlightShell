# DarkShadow: transparent btop theme (the terminal's own background and blur show through)
# Colors follow the shell's purple accent. With wallpaper colors on, btop uses the "matugen" theme instead.
theme[main_bg]=""
theme[main_fg]="#d7d3e6"
theme[title]="#e8e4f7"
theme[hi_fg]="#b69cff"
theme[selected_bg]="#3a2f5c"
theme[selected_fg]="#f0ecff"
theme[inactive_fg]="#5d587a"
theme[graph_text]="#a59fc4"
theme[meter_bg]="#2c2842"
theme[proc_misc]="#7fd6c2"
theme[cpu_box]="#4a4466"
theme[mem_box]="#4a4466"
theme[net_box]="#4a4466"
theme[proc_box]="#4a4466"
theme[div_line]="#322e4a"

theme[temp_start]="#7fd6c2"
theme[temp_mid]="#e6c07b"
theme[temp_end]="#f07178"
theme[cpu_start]="#8f7cf0"
theme[cpu_mid]="#b69cff"
theme[cpu_end]="#e39bff"
theme[free_start]="#4fb89e"
theme[free_mid]="#7fd6c2"
theme[free_end]="#b6f0e2"
theme[cached_start]="#6a5fd0"
theme[cached_mid]="#8f7cf0"
theme[cached_end]="#b69cff"
theme[available_start]="#4fb89e"
theme[available_mid]="#7fd6c2"
theme[available_end]="#b6f0e2"
theme[used_start]="#b69cff"
theme[used_mid]="#e39bff"
theme[used_end]="#f07178"
theme[download_start]="#6a5fd0"
theme[download_mid]="#8f7cf0"
theme[download_end]="#e39bff"
theme[upload_start]="#4fb89e"
