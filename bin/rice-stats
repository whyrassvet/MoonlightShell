#!/usr/bin/env python3
# prints one JSON line every 2 seconds (or every N seconds: rice-stats N):
# {"cpu":N,"ram":N,"gpu":N,"temp":C,"gtemp":C,"ramu":GB,"ramt":GB,"swap":N,"swapu":GB,"swapt":GB,"disk":N,"disku":GB,"diskt":GB}
# cpu/ram/gpu in %, temp = CPU temperature, gtemp = GPU temperature (0 when unknown)
import glob
import json
import shutil
import subprocess
import sys
import time


def cpu_times():
    f = open("/proc/stat").readline().split()[1:]
    v = [int(x) for x in f]
    return v[3] + v[4], sum(v)


def ram():
    m = {}
    for ln in open("/proc/meminfo"):
        k, v = ln.split(":")[0], ln.split(":")[1].split()[0]
        m[k] = int(v)
    t = m.get("MemTotal", 1)
    used = t - m.get("MemAvailable", 0)
    return round(100 * used / t), round(used / 1048576, 1), round(t / 1048576, 1)


def swap():
    m = {}
    for ln in open("/proc/meminfo"):
        k, v = ln.split(":")[0], ln.split(":")[1].split()[0]
        m[k] = int(v)
    t = m.get("SwapTotal", 0)
    used = t - m.get("SwapFree", 0)
    return (round(100 * used / t) if t else 0), round(used / 1048576, 1), round(t / 1048576, 1)


def disk():
    try:
        d = shutil.disk_usage("/")
        return round(100 * d.used / d.total), round(d.used / 1e9), round(d.total / 1e9)
    except OSError:
        return 0, 0, 0


def read(p):
    try:
        return open(p).read().strip()
    except Exception:
        return ""


def hwmon(names):
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        if read(d + "/name") in names:
            for f in ("temp1_input", "temp2_input"):
                v = read(d + "/" + f)
                if v.isdigit():
                    return round(int(v) / 1000)
    return 0


def cpu_temp():
    t = hwmon(("k10temp", "coretemp", "zenpower", "cpu_thermal", "acpitz"))
    if t:
        return t
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        if read(z + "/type") in ("x86_pkg_temp", "cpu-thermal", "TCPU", "acpitz"):
            v = read(z + "/temp")
            if v.isdigit():
                return round(int(v) / 1000)
    return 0


NV = shutil.which("nvidia-smi")
DRM = [p for p in glob.glob("/sys/class/drm/card*/device/gpu_busy_percent")]


def gpu():
    """(busy %, temperature) of the first GPU that tells: NVIDIA via nvidia-smi, AMD / Intel via sysfs"""
    if NV:
        try:
            o = subprocess.run([NV, "--query-gpu=utilization.gpu,temperature.gpu", "--format=csv,noheader,nounits"],
                               capture_output=True, text=True, timeout=3).stdout.strip().split("\n")[0].split(",")
            return int(float(o[0])), int(float(o[1]))
        except Exception:
            pass
    for p in DRM:
        v = read(p)
        if v.isdigit():
            return int(v), hwmon(("amdgpu", "i915", "xe"))
    return 0, hwmon(("amdgpu", "nouveau", "i915", "xe"))


every = 2.0
if len(sys.argv) > 1:
    try:
        every = max(0.5, min(10.0, float(sys.argv[1])))
    except ValueError:
        pass
idle0, tot0 = cpu_times()
while True:
    time.sleep(every)
    idle1, tot1 = cpu_times()
    dt = tot1 - tot0
    c = round(100 * (1 - (idle1 - idle0) / dt)) if dt > 0 else 0
    idle0, tot0 = idle1, tot1
    r, ru, rt = ram()
    g, gt = gpu()
    s, su, stt = swap()
    dk, du, dt2 = disk()
    sys.stdout.write(json.dumps({"cpu": max(0, min(100, c)), "ram": r, "gpu": max(0, min(100, g)),
                                 "temp": cpu_temp(), "gtemp": gt, "ramu": ru, "ramt": rt,
                                 "swap": s, "swapu": su, "swapt": stt, "disk": dk, "disku": du, "diskt": dt2}) + "\n")
    sys.stdout.flush()
