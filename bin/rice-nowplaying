#!/usr/bin/env python3
# prints "Artist - Title" of the playing MPRIS player (a blank line if none)
import json
import subprocess
import sys


def run(a):
    try:
        return subprocess.run(a, capture_output=True, text=True, timeout=2).stdout
    except Exception:
        return ""


def prop(name, p):
    try:
        return json.loads(run(["busctl", "--user", "--json=short", "get-property", name,
                               "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", p]))["data"]
    except Exception:
        return None


names = [l.split()[0] for l in run(["busctl", "--user", "list", "--no-legend"]).splitlines()
         if l.startswith("org.mpris.MediaPlayer2.")]
best = None
for n in names:
    st = prop(n, "PlaybackStatus")
    if best is None or st == "Playing":
        best = (n, st)
    if st == "Playing":
        break
if not best:
    print(" ")
    sys.exit(0)
md = prop(best[0], "Metadata") or {}
title = (md.get("xesam:title") or {}).get("data", "")
artist = (md.get("xesam:artist") or {}).get("data", [])
if isinstance(artist, list):
    artist = ", ".join(artist)
line = (artist + " - " + title) if artist and title else (title or artist)
print(line if line else " ")
