#!/usr/bin/env python3
"""rice-theme: whole-desktop themes, and your colors in your apps (Settings > Appearance > Themes).

A theme is a color scheme and a design: corners, shapes, the bar, the widgets, notifications, window corners and
gaps, motion and the font. Your apps take the colors too: VSCodium / VS Code and Discord (Vesktop, Vencord,
Equicord, BetterDiscord), every time the colors change (a new wallpaper, another scheme).

  rice-theme list              the themes (JSON)
  rice-theme state             the theme you have and the apps it colors (JSON)
  rice-theme apply KEY         use a theme
  rice-theme app vscode|discord on|off
  rice-theme sync              color the apps again from your colors now (matugen calls it)
"""
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
CONF = DIR + "/theme.json"
PALETTE = DIR + "/palette.json"
APPPREFS = DIR + "/settings-app.json"
BIN = HOME + "/.local/bin/"
XDG = os.environ.get("XDG_CONFIG_HOME") or HOME + "/.config"
FLAT = HOME + "/.var/app"
UI_FONT = "Google Sans Flex"
MONO_FONT = "JetBrainsMono Nerd Font"

# key: name, what it is like, colors (rice-colors), and the design
