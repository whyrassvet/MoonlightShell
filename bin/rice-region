#!/usr/bin/env python3
"""rice-region state | set KEY VALUE
Language and region of the shell (Settings > Sound & language > Language & region), in ~/.config/rice/region.json:
  clock 24|12     the clock on the bar, the game bar and the desktop clock
  units c|f       temperatures: weather widgets and the lock screen
  week mon|sun    the first day of the week in calendars
  lang  CODE      the language you prefer (the shell speaks English for now; it is kept for later)"""
import json
import os
import sys

CFG = os.path.expanduser("~/.config/rice/region.json")
DEFAULTS = {"clock": "24", "units": "c", "week": "mon", "lang": "en"}
CHOICES = {"clock": ("24", "12"), "units": ("c", "f"), "week": ("mon", "sun"),
           "lang": ("en", "pl", "de", "fr", "es", "pt", "it", "nl", "ru", "uk", "cs", "tr", "ja", "ko", "zh")}


def load():
    c = dict(DEFAULTS)
    try:
        j = json.load(open(CFG))
        for k in DEFAULTS:
            if j.get(k) in CHOICES[k]:
                c[k] = j[k]
    except Exception:
        pass
    return c


def main(a):
    if len(a) >= 2 and a[1] == "state":
        print(json.dumps(load()))
    elif len(a) == 4 and a[1] == "set":
        k, v = a[2], a[3]
        if k not in CHOICES or v not in CHOICES[k]:
            sys.exit("%s: %s" % (k, "|".join(CHOICES.get(k, ()))))
        c = load()
        c[k] = v
        os.makedirs(os.path.dirname(CFG), exist_ok=True)
        tmp = CFG + ".tmp"
        json.dump(c, open(tmp, "w"))
        os.replace(tmp, CFG)
        if k == "units":
            # the next weather read uses the new unit
            for f in ("weather.txt",):
                try:
                    os.remove(os.path.expanduser("~/.cache/rice/" + f))
                except OSError:
                    pass
        print("Saved: %s = %s" % (k, v))
    else:
        sys.exit(__doc__)


main(sys.argv)
