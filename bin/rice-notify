#!/usr/bin/env python3
"""Notification settings: rice-notify state|set KEY VALUE|apply|reset|test|panel."""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
CFG = DIR + "/notify.json"
LUA = HOME + "/.config/hypr/rice-notify.lua"
HLUA = HOME + "/.config/hypr/hyprland.lua"
COLORS = DIR + "/colors.css"
DEFAULTS = {
    "pos_x": "right", "pos_y": "top", "margin": 10,
    "layout": "deck", "panel_width": 440, "panel_height": 820, "fit": True,
    "w_buttons": True, "w_media": True, "w_volume": True, "w_dnd": True, "w_title": True,
    "cc_side": "right", "cc_float": True, "w_quick": True, "w_power": True,
    "w_brightness": True, "w_session": True, "popup_width": 360, "timeout": 6,
    "critical_sticky": True, "icon_size": 40, "images": True, "style": "glass",
    "popup_style": "match", "opacity": 0.80, "radius": 18, "blur": True,
    "compact": False, "accent": True, "colors": "shell", "font": "sans", "font_size": 13,
    "popup_opacity": 0.85, "blur_popups": True, "border": "none", "shadow": False,
    "sound": "glass", "sound_volume": 70,
}
INTS = {"margin": (0, 60), "panel_width": (300, 700), "panel_height": (300, 1400),
        "popup_width": (260, 600), "timeout": (2, 30), "icon_size": (20, 72),
        "radius": (0, 32), "font_size": (10, 18), "sound_volume": (0, 100)}
FLOATS = {"opacity": (0.3, 1.0), "popup_opacity": (0.3, 1.0)}
CHOICES = {"pos_x": ["left", "center", "right"], "pos_y": ["top", "bottom"],
           "layout": ["deck", "controls-top", "controls-bottom", "minimal"],
           "style": ["glass", "solid", "google", "outline"], "cc_side": ["left", "right", "top", "bottom"],
           "popup_style": ["match", "glass", "solid", "minimal", "pill", "accent", "glow", "island", "light"],
           "colors": ["shell", "black", "graphite", "slate", "white", "tinted"],
           "font": ["sans", "rounded", "mono", "system"], "border": ["subtle", "accent", "none"],
           "sound": ["glass", "droplet", "chime", "bubble", "marimba", "aurora", "ping", "harp", "keys", "ripple", "off"]}


def load():
    try:
        with open(CFG) as f:
            raw = json.load(f)
    except (OSError, ValueError):
        raw = {}
    c = dict(DEFAULTS)
    for k, default in DEFAULTS.items():
        v = raw.get(k, default)
        if isinstance(default, bool):
            c[k] = v is True
        elif k in CHOICES:
            c[k] = v if v in CHOICES[k] else default
        else:
            bounds = FLOATS.get(k, INTS.get(k))
            try:
                value = max(bounds[0], min(bounds[1], float(v)))
                c[k] = round(value, 2) if k in FLOATS else int(value)
            except (TypeError, ValueError):
                c[k] = default
    if raw.get("v", 1) < 2:
        c["layout"], c["w_volume"] = "deck", True
    if raw.get("v", 1) < 3:
        c["fit"], c["panel_width"] = True, max(c["panel_width"], 440)
    if raw.get("v", 1) < 4:
        c["border"] = "none"
    c["v"] = 4
    return c


def save(c):
    os.makedirs(DIR, exist_ok=True)
    with open(CFG + ".tmp", "w") as f:
        json.dump(c, f)
    os.replace(CFG + ".tmp", CFG)


def quiet(cmd):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=6)
    except (OSError, subprocess.TimeoutExpired):
        pass


def apply(c, reload=False):
    lines = ["-- generated by rice-notify (Settings > Notifications). Do not edit by hand.\n"]
    for ns, enabled in (("rice-cc", c["blur"]), ("rice-notify-popup", c["blur_popups"])):
        if enabled:
            lines.append('hl.layer_rule({\n    name  = "%s-blur",\n    match = { namespace = "%s" },\n'
                         '    blur = true,\n    ignore_alpha = 0.5,\n})\n' % (ns, ns))
    text = "".join(lines)
    try:
        with open(LUA) as f:
            old = f.read()
    except OSError:
        old = None
    changed = old != text
    if changed:
        os.makedirs(os.path.dirname(LUA), exist_ok=True)
        with open(LUA, "w") as f:
            f.write(text)
    if os.path.exists(HLUA):
        with open(HLUA) as f:
            main = f.read()
        if 'require("rice-notify")' not in main:
            if not os.path.exists(HLUA + ".bak-notify"):
                shutil.copy2(HLUA, HLUA + ".bak-notify")
            with open(HLUA, "a") as f:
                f.write('\nrequire("rice-notify")\n')
            changed = True
    if changed or reload:
        quiet([HOME + "/.local/bin/rice-wm", "reload"])


def state():
    c = load()
    try:
        with open(COLORS) as f:
            css = f.read()
        def color(name, default):
            match = re.search(r"@define-color\s+" + name + r"\s+#([0-9a-fA-F]{6})", css)
            return "#" + match.group(1) if match else default
        c["accent_color"], c["on_accent"] = color("accent", "#d4d4d4"), color("on_accent", "#0d0d0d")
    except OSError:
        c["accent_color"], c["on_accent"] = "#d4d4d4", "#0d0d0d"
    try:
        c["have_power_profiles"] = subprocess.run(["powerprofilesctl", "get"], capture_output=True, timeout=3).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        c["have_power_profiles"] = False
    c["have_backlight"] = os.path.isdir("/sys/class/backlight") and bool(os.listdir("/sys/class/backlight"))
    c["flat"] = os.path.exists(HOME + "/.cache/rice/flat")
    return c


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "state":
        print(json.dumps(state()))
    elif cmd == "test":
        quiet(["notify-send", "Moonlight Shell", "This is how your notifications look."])
    elif cmd == "panel":
        quiet([HOME + "/.local/bin/rice-cc", "open"])
    elif cmd in ("apply", "set", "reset"):
        os.makedirs(DIR, exist_ok=True)
        with open(DIR + "/.notify.lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            c = dict(DEFAULTS, v=4) if cmd == "reset" else load()
            if cmd == "set":
                if len(argv) < 4 or argv[2] not in DEFAULTS:
                    sys.exit("usage: rice-notify set KEY VALUE")
                k, v = argv[2:4]
                if isinstance(DEFAULTS[k], bool):
                    c[k] = v.lower() in ("1", "true", "on", "yes")
                elif k in CHOICES:
                    if v not in CHOICES[k]:
                        sys.exit("%s: %s" % (k, "|".join(CHOICES[k])))
                    c[k] = v
                else:
                    bounds = FLOATS.get(k, INTS.get(k))
                    value = max(bounds[0], min(bounds[1], float(v)))
                    c[k] = round(value, 2) if k in FLOATS else int(value)
            save(c)
            apply(c, "--reload" in argv)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
