}
.widget-buttons-grid > flowbox > flowboxchild > button:hover,
.widget-buttons-grid > flowbox > flowboxchild > button:checked {
  background: %(acc)s;
  color: %(onacc)s;
}
.widget-volume {
  margin: %(pad2)dpx %(pad)dpx;
  padding: %(pad2)dpx %(pad)dpx;
  background: %(card)s;
  border-radius: %(ri)dpx;
}
.widget-volume trough highlight {
  background: %(acc)s;
}
%(popupcss)s
%(deckcss)s
%(end)s
%(googlecss)s
""" % dict(v, begin=BEGIN, end=END, popupcss=popup_css(c, acc, on_acc), deckcss=deck_css(c, v), googlecss=google_css(c, v))


def hex_rgb(h):
    h = (h or "").lstrip("#")
    try:
        return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    except Exception:
        return (212, 212, 212)


def mixc(a, b, k):
    return tuple(int(round(a[i] + (b[i] - a[i]) * k)) for i in range(3))


def rgbs(t):
    return "rgb(%d, %d, %d)" % t


def deck_css(c, v):
    """The Deck notification center: rounded tiles, big soft sliders, power buttons at the bottom."""
    if c["layout"] != "deck":
        return ""
    r = v["r"]
    if c["cc_float"]:
        rad = "%dpx" % r
    else:
        rad = {"right": "%dpx 0 0 %dpx" % (r, r), "left": "0 %dpx %dpx 0" % (r, r),
