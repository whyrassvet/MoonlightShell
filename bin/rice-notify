def hex_rgba(h, a):
    h = h.lstrip("#")
    try:
        return "rgba(%d, %d, %d, %.2f)" % (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16), a)
    except Exception:
        return "rgba(212, 212, 212, %.2f)" % a


def popup_css(c, acc, on_acc):
    """Extra look for the popups only (the notification center keeps the 'Look' setting)."""
    st = c["popup_style"]
    if st == "match":
        return ""
    base, fg, dim, _ = palette(c, acc)
    pop = c["popup_opacity"]

    def bgc(a):
        return "rgba(%d, %d, %d, %.2f)" % (base[0], base[1], base[2], a)

    P = ".floating-notifications .notification-row .notification-background .notification"
    r = c["radius"]
    line = "rgba(0, 0, 0, 0.08)" if c["colors"] == "white" else "rgba(255, 255, 255, 0.10)"
    if c["border"] == "none":
        line = "transparent"
    elif c["border"] == "accent":
        line = acc
    rules = {
        "glass":   "background: %s;\n  border: 1px solid %s;\n  border-radius: %dpx;" % (bgc(min(pop, 0.62)), line, r),
        "solid":   "background: %s;\n  border: 1px solid %s;\n  border-radius: %dpx;" % (bgc(1.0), line, r),
        "minimal": "background: %s;\n  border: none;\n  border-radius: 8px;\n  padding: 8px 10px;" % bgc(pop),
        "pill":    "background: %s;\n  border: 1px solid %s;\n  border-radius: 999px;\n  padding: 6px 18px;" % (bgc(pop), line),
        "accent":  "background: %s;\n  border: 1px solid %s;\n  border-left: 4px solid %s;\n  border-radius: 10px;" % (bgc(pop), line, acc),
        "glow":    "background: %s;\n  border: 1px solid %s;\n  border-radius: %dpx;\n  box-shadow: 0 0 16px %s;" % (bgc(pop), acc, r, hex_rgba(acc, 0.45)),
        "island":  "background: rgb(0, 0, 0);\n  border: none;\n  border-radius: 28px;\n  padding: 12px 18px;",
        "light":   "background: rgba(246, 245, 244, %.2f);\n  border: 1px solid %s;\n  border-radius: %dpx;" % (max(pop, 0.9), "transparent" if c["border"] == "none" else "rgba(0, 0, 0, 0.08)", r),
    }
    out = ["/* popup style: %s */" % st, "%s {\n  %s\n}" % (P, rules[st])]
    if st == "pill":
        out.append("%s .image, %s .app-icon {\n  border-radius: 999px;\n}" % (P, P))
    if st == "minimal":
        out.append("%s .summary {\n  font-size: 0.95em;\n}" % P)
    if st in ("light", "island"):
        tf, td = ("#111111", "#555555") if st == "light" else ("#F6F5F4", "#9a9aa4")
        out.append("%s .summary {\n  color: %s;\n}\n%s .body, %s .time {\n  color: %s;\n}" % (P, tf, P, P, td))
    if st == "light":
        out.append(".floating-notifications .notification-row .notification-background .close-button {\n"
                   "  background: rgba(0, 0, 0, 0.08);\n  color: #111111;\n}")
    return "\n".join(out)


def strong(text):
    # popups live in a window with both classes: ".floating-notifications.background".
    # Using both makes our rules beat themes that use the same long selectors.
    return text.replace(".floating-notifications .notification-row", ".floating-notifications.background .notification-row")


def flat():
    """rice-effects: blur and transparency are off right now (Lite, or gaming mode)"""
    return os.path.exists(os.path.expanduser("~/.cache/rice/flat"))


def write_css(c):
    if flat():
        c = dict(c, opacity=1.0, popup_opacity=1.0)
    s = open(SWCSS).read() if os.path.exists(SWCSS) else ""
    backup_once(SWCSS, ".bak-rice-notify")
    s = re.sub(r"\n?" + re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", "\n", s, flags=re.S)
    os.makedirs(SW, exist_ok=True)
    tmp = SWCSS + ".tmp"
    open(tmp, "w").write(s.rstrip() + "\n\n" + strong(css(c)))
    os.replace(tmp, SWCSS)


# ---------------- blur (Hyprland layer rules) ----------------
def lua_text(c):
    out = ["-- generated by rice-notify (Settings > Notifications). Do not edit by hand.\n"]
    flat_look = c["style"] in ("solid", "google")     # opaque looks: nothing to blur
    # swaync's panel and pop-ups, and the shell's own: the control center and its pop-ups (rice-cc engine shell)
    for ns, on, ia in (("swaync-control-center", c["blur"] and not flat_look, 0.1),
                       ("swaync-notification-window", c["blur_popups"] and not flat_look, 0.1),
                       ("rice-cc", c["blur"], 0.5), ("rice-notify-popup", c["blur_popups"], 0.5)):
        if on:
            out.append('hl.layer_rule({\n    name  = "%s-blur",\n    match = { namespace = "%s" },\n'
                       '    blur = true,\n    ignore_alpha = %s,\n})\n' % (ns if ns.startswith("rice-") else "rice-" + ns, ns, ia))
    return "".join(out)


def wire_hypr():
    if not os.path.exists(HLUA):
        return False
    s = open(HLUA).read()
    n = re.sub(r'hl\.layer_rule\(\{\s*name\s*=\s*"swaync-blur",.*?\}\)\n?\n?', "", s, flags=re.S)
    if 'require("rice-notify")' not in n:
        a = 'require("rice-settings")'
        n = n.replace(a, a + '\nrequire("rice-notify")') if n.count(a) == 1 else n.rstrip("\n") + '\n\nrequire("rice-notify")\n'
    if n != s:
        backup_once(HLUA, ".bak-notify")
        open(HLUA, "w").write(n)
        return True
    return False


def quiet(cmd, timeout=6):
    if shutil.which(cmd[0]):
        try:
            subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout)
        except subprocess.TimeoutExpired:
            pass


def keep_log(msg):
    try:
        os.makedirs(os.path.dirname(KEEP_LOG), exist_ok=True)
        if os.path.exists(KEEP_LOG) and os.path.getsize(KEEP_LOG) > 64000:
            os.replace(KEEP_LOG, KEEP_LOG + ".old")
        with open(KEEP_LOG, "a") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")
    except Exception:
        pass


def post_kept(app, icon, summary, body, urg):
    """put the quiet copy in the notification center: notify-send, else plain D-Bus (busctl, gdbus)"""
    ub = {"low": 0, "normal": 1, "critical": 2}[urg]
    tries = []
    if shutil.which("notify-send"):
        tries.append(["notify-send", "-a", app, "-u", urg, "-i", icon, "-c", "rice.kept",
                      "-h", "boolean:resident:true", "--", summary, body])
    if shutil.which("busctl"):
        tries.append(["busctl", "--user", "call", "--", "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                      "org.freedesktop.Notifications", "Notify", "susssasa{sv}i", app, "0", icon, summary, body, "0",
                      "3", "resident", "b", "true", "category", "s", "rice.kept", "urgency", "y", str(ub), "-1"])
    if shutil.which("gdbus"):
        def gv(t):
            return "'" + t.replace("\\", "\\\\").replace("'", "\\'") + "'"
        tries.append(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                      "--object-path", "/org/freedesktop/Notifications", "--method",
                      "org.freedesktop.Notifications.Notify", "--", gv(app), "0", gv(icon), gv(summary), gv(body), "[]",
                      "{'resident': <true>, 'category': <'rice.kept'>, 'urgency': <byte %d>}" % ub, "-1"])
    if not tries:
        return "no notify-send, busctl or gdbus found (PATH=%s)" % os.environ.get("PATH", "")
    err = ""
    for cmd in tries:
        try:
            r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, timeout=10)
            if r.returncode == 0:
                return ""
            err += "%s: %s; " % (cmd[0], (r.stderr or "").strip()[:200])
        except Exception as e:
            err += "%s: %s; " % (cmd[0], e)
    return err


def keep():
    """swaync runs this when a notification is clicked (just before it removes it): post a quiet copy that stays"""
    e = os.environ
    if e.get("SWAYNC_CATEGORY") == "rice.kept" or e.get("SWAYNC_HINT_RESIDENT", "").lower() in ("true", "1"):
        return
    summary, body = e.get("SWAYNC_SUMMARY", ""), e.get("SWAYNC_BODY", "")
    if not summary and not body:
        return
    app = e.get("SWAYNC_APP_NAME") or "Notification"
    urg = {"low": "low", "critical": "critical"}.get(e.get("SWAYNC_URGENCY", "").lower(), "normal")
    icon = e.get("SWAYNC_DESKTOP_ENTRY") or app.lower()
    # let go of swaync's pipe before anything else: swaync 0.12 crashes when it is still open after we end
    try:
        fd = os.open(os.devnull, os.O_RDWR)
        for n in (0, 1, 2):
            os.dup2(fd, n)
        if fd > 2:
            os.close(fd)
    except OSError:
        pass
    if os.fork() > 0:      # give swaync its answer at once
        return
    os.setsid()
    time.sleep(0.2)        # after swaync has removed the clicked one
    err = post_kept(app, icon, summary, body, urg)
    keep_log(("kept: " if not err else "FAILED: " + err + " for: ") + app + " / " + summary[:60])
    os._exit(0)


def doctor():
    """why are clicked notifications gone? checks every part of 'keep clicked notifications'"""
    c = load()
    ok = lambda b: "ok  " if b else "NO  "
    print(ok(shutil.which("swaync") or shutil.which("swaync-client")), "swaync installed")
    running = subprocess.run(["pgrep", "-x", "swaync"], stdout=subprocess.DEVNULL).returncode == 0 if shutil.which("pgrep") else False
    print(ok(running), "swaync running")
    print(ok(c["keep_clicked"]), "Keep clicked notifications is on (Settings > Notifications)")
    try:
        j = json.load(open(SWCFG))
    except Exception:
        j = {}
    sc = (j.get("scripts") or {}).get("rice-keep", {})
    print(ok(sc.get("exec", "").startswith(RUN)), "swaync config runs it:", sc.get("exec", "(missing)"))
    vis = (j.get("notification-visibility") or {}).get("rice-kept", {})
    print(ok(vis.get("state") == "muted"), "kept copies go only to the notification center")
    print(ok(os.path.exists(HOME + "/.local/bin/rice-run")), "~/.local/bin/rice-run")
    tools = [t for t in ("notify-send", "busctl", "gdbus") if shutil.which(t)]
    print(ok(tools), "a way to post notifications:", ", ".join(tools) or "none (install libnotify)")
    if os.path.exists("/proc"):
        for pid in os.listdir("/proc"):
            try:
                if open("/proc/%s/comm" % pid).read().strip() != "swaync":
                    continue
                env = open("/proc/%s/environ" % pid, "rb").read().split(b"\0")
                path = next((x[5:].decode() for x in env if x.startswith(b"PATH=")), "")
                py = any(os.path.exists(d + "/python3") for d in path.split(":") if d)
                print(ok(py), "swaync can find python3 by itself", "" if py else "(rice-run fixes this)")
                break
            except Exception:
                continue
    if os.path.exists(KEEP_LOG):
        print("\nlast clicks (" + KEEP_LOG + "):")
        print("".join(open(KEEP_LOG).readlines()[-5:]).rstrip())
    else:
        print("\nno click logged yet: click a notification, then run rice-notify doctor again")


def shell_engine():
    """the shell shows notifications itself (rice-cc engine shell): swaync stays off, so no swaync-client calls
    (they would start swaync again through D-Bus)"""
    try:
        return json.load(open(HOME + "/.config/rice/cc.json")).get("engine") == "shell"
    except Exception:
        return False


def apply(c, reload_hypr=False):
    # the blur rules first: a broken swaync style must never cost the shell its blur
    for f in (write_config, write_css):
        try:
            f(c)
        except Exception as e:
            print("rice-notify: %s skipped (%s)" % (f.__name__, e), file=sys.stderr)
    old = open(LUA).read() if os.path.exists(LUA) else None
    new = lua_text(c)
    changed = old != new
    if changed:
        os.makedirs(os.path.dirname(LUA), exist_ok=True)
        open(LUA, "w").write(new)
    if wire_hypr():
        changed = True
    if not shell_engine():
        quiet(["swaync-client", "-R", "-sw"])
        quiet(["swaync-client", "-rs", "-sw"])
    if changed or reload_hypr:
        quiet([os.path.expanduser("~/.local/bin/rice-wm"), "reload"])


def test():
    # plain D-Bus call, works without notify-send
    quiet(["busctl", "--user", "call", "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
           "org.freedesktop.Notifications", "Notify", "susssasa{sv}i", "DarkShadow's Shell", "0",
           (HOME + "/.face") if os.path.exists(HOME + "/.face") else "dialog-information", "Hello from DarkShadow's Shell",
           "This is how your notifications look. Change them in Settings > Notifications.", "0", "0", "6000"])


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "keep":
        keep()
        return
    if cmd == "doctor":
        doctor()
        return
    if cmd == "state":
        out = load()
        out["accent_color"], out["on_accent"] = accent()
        out["installed"] = shutil.which("swaync-client") is not None
        out["have_power_profiles"] = power_profiles_ok()
        out["have_backlight"] = backlight_device() != ""
        out["flat"] = flat()
        print(json.dumps(out))
        return
    if cmd == "test":
        test()
        return
    if cmd == "panel":
        if shell_engine():
            quiet([HOME + "/.local/bin/rice-cc", "open"])
        else:
            quiet(["swaync-client", "-t", "-sw"])
        return
    os.makedirs(DIR, exist_ok=True)
    lk = open(DIR + "/.notify.lock", "w")
    fcntl.flock(lk, fcntl.LOCK_EX)
    if cmd == "apply":
        c = load()
        save(c)
        apply(c, reload_hypr="--reload" in argv)
    elif cmd == "set":
        if len(argv) < 4 or argv[2] not in DEFAULTS:
            die("usage: rice-notify set KEY VALUE   keys: " + " ".join(DEFAULTS))
        k, v = argv[2], argv[3]
        c = load()
        d = DEFAULTS[k]
        if isinstance(d, bool):
            c[k] = v.lower() in ("1", "true", "on", "yes")
        elif k in CHOICES:
            if v not in CHOICES[k]:
                die("%s: %s" % (k, "|".join(CHOICES[k])))
            c[k] = v
        elif k in FLOATS:
            c[k] = round(clamp(float(v), *FLOATS[k]), 2)
        else:
            c[k] = int(clamp(float(v), *INTS[k]))
        save(c)
        apply(c)
    elif cmd == "reset":
        if os.path.exists(CFG):
            os.remove(CFG)
        c = load()
        save(c)
        apply(c)
    elif cmd == "restore":
        for p, b in ((SWCFG, ".bak-rice-notify"), (SWCSS, ".bak-rice-notify"), (HLUA, ".bak-notify")):
            if os.path.exists(p + b):
                shutil.copy2(p + b, p)
                print("restored", p)
        if os.path.exists(LUA):
            os.remove(LUA)
        quiet(["swaync-client", "-R", "-sw"])
        quiet(["swaync-client", "-rs", "-sw"])
        quiet([os.path.expanduser("~/.local/bin/rice-wm"), "reload"])
    else:
        die(__doc__)


if __name__ == "__main__":
    main(sys.argv)
