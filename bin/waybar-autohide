#!/usr/bin/env python3
# Hides Waybar until the pointer touches the screen edge (top or bottom, following the bar position).
import fcntl
import json
import os
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
UI = HOME + "/.config/waybar/ui.json"
CFG = HOME + "/.config/waybar/config.jsonc"
LOCK = HOME + "/.cache/rice/autohide.lock"
ZONE = 70


def run(a):
    try:
        return subprocess.run(a, capture_output=True, text=True, timeout=2).stdout
    except Exception:
        return ""


def enabled():
    try:
        return json.load(open(UI)).get("autohide") is True
    except Exception:
        return False


def position():
    try:
        return "bottom" if json.load(open(CFG)).get("position") == "bottom" else "top"
    except Exception:
        return "top"


def waybar_pid():
    for n in (".waybar-wrapped", "waybar"):
        o = run(["pgrep", "-x", n]).split()
        if o:
            return int(o[0])
    return None


def monitor():
    try:
        ms = json.loads(run(["hyprctl", "-j", "monitors"]))
        m = next((x for x in ms if x.get("focused")), ms[0])
        return m["x"], m["y"], int(m["width"] / m["scale"]), int(m["height"] / m["scale"])
    except Exception:
        return 0, 0, 1920, 1080


def cursor():
    try:
        x, y = run(["hyprctl", "cursorpos"]).strip().split(",")
        return float(x), float(y)
    except Exception:
        return None


def daemon():
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    lk = open(LOCK, "w")
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    shown = False
    last_pid = None
    leave = None
    pos = "top"
    mon = (0, 0, 1920, 1080)
    t_cfg = 0
    while True:
        now = time.time()
        if now - t_cfg > 3:
            t_cfg = now
            if not enabled():
                return
            pos = position()
            mon = monitor()
        pid = waybar_pid()
        if pid != last_pid:
            last_pid = pid
            shown = False
            leave = None
        c = cursor()
        if pid and c:
            y = c[1] - mon[1]
            h = mon[3]
            near = y <= 1 if pos == "top" else y >= h - 2
            inside = y <= ZONE if pos == "top" else y >= h - ZONE
            if not shown and near:
                os.kill(pid, 10)  # SIGUSR1 toggles visibility
                shown = True
                leave = None
            elif shown:
                if inside:
                    leave = None
                elif leave is None:
                    leave = now
                elif now - leave > 0.6:
                    os.kill(pid, 10)
                    shown = False
                    leave = None
        time.sleep(0.07)


def main(a):
    cmd = a[1] if len(a) > 1 else ""
    if cmd == "daemon":
        daemon()
    elif cmd in ("start", "ensure"):
        if cmd == "ensure" and not enabled():
            return
        subprocess.Popen([sys.argv[0], "daemon"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    elif cmd == "stop":
        subprocess.run(["pkill", "-f", "waybar-autohide daemon"])
    else:
        sys.exit("usage: waybar-autohide start|stop|ensure|daemon")


main(sys.argv)
