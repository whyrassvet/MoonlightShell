                "memory", "break", "colors"],
    "minimal": ["title", "os", "wm", "shell", "terminal", "memory"],
}
# DarkShadow's own logo: a crescent moon and a few stars ($1 the wallpaper's main color, $2 the second one)
# DarkShadow's own logo: a crescent moon with craters and a few stars, about as big as a distro logo
# ($1 the wallpaper's main color, $2 the second one for the craters, $3 the stars)
