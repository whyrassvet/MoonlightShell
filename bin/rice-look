#!/usr/bin/env python3
"""rice-look: Settings > Desktop > Look & Feel: fastfetch, your shell and your terminal.

  rice-look state                  JSON for Settings
  rice-look fetch KEY VALUE        on_open on|off, logo distro|small|darkshadow|blackhole|wallpaper|none,
                                   info full|compact|minimal, labels text|icons, colors wallpaper|plain
  rice-look fetch-own              use DarkShadow's fastfetch config again (instead of your own)
  rice-look preview                fastfetch as HTML (the preview in Settings)
  rice-look shell fish|zsh|bash    the shell your terminals start
  rice-look login-shell            make it your login shell too (opens a terminal: chsh asks your password)
  rice-look terminal NAME          the terminal the keys open (kitty, foot, alacritty, ghostty, wezterm, konsole)
  rice-look install NAME           install a shell or terminal (opens a terminal with the package manager)
  rice-look try                    open your terminal with fastfetch in it
  rice-look colors                 the wallpaper changed: the terminals' colors, fastfetch's colors and logo
  rice-look apply                  write everything again from the saved choices (the installer runs this)

Your shell and terminal get the wallpaper's colors, the monospace font (Settings > Appearance > Fonts) and the
see-through background of kitty. Files that are yours (a foot.ini, alacritty.toml, ghostty config you wrote) are
kept: the DarkShadow look goes in its own file that yours includes.
"""
import html
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
CFG = os.environ.get("XDG_CONFIG_HOME") or HOME + "/.config"
RICE = CFG + "/rice"
STATE = RICE + "/look.json"
TERMFILE = RICE + "/terminal"
FETCH_ON = RICE + "/fetch-on-open"
BIN = HOME + "/.local/bin"
CACHE = HOME + "/.cache/rice"
FF_DIR = CFG + "/fastfetch"
FF_CFG = FF_DIR + "/config.jsonc"
MARK = "DarkShadow's Shell"

SHELLS = [
    {"id": "fish", "name": "fish", "desc": "Friendly: suggestions as you type, colors, no setup"},
    {"id": "zsh", "name": "zsh", "desc": "Powerful and loved by tinkerers (Oh My Zsh, plugins)"},
    {"id": "bash", "name": "bash", "desc": "The classic one, on every Linux"},
]
TERMS = [
    {"id": "kitty", "name": "kitty", "app": "kitty", "desc": "Fast, images, tabs and splits", "images": True},
    {"id": "foot", "name": "foot", "app": "foot", "desc": "Tiny and very quick to open", "images": False},
    {"id": "alacritty", "name": "Alacritty", "app": "Alacritty", "desc": "Simple and fast (no tabs)", "images": False},
    {"id": "ghostty", "name": "Ghostty", "app": "com.mitchellh.ghostty", "desc": "Modern, native and fast, images", "images": True},
    {"id": "wezterm", "name": "WezTerm", "app": "org.wezfurlong.wezterm", "desc": "Tabs, splits, set up in Lua, images", "images": True},
    {"id": "konsole", "name": "Konsole", "app": "org.kde.konsole", "desc": "KDE's terminal", "images": False},
]
DEFAULTS = {"shell": "", "terminal": "", "on_open": False, "logo": "distro", "info": "full", "labels": "text",
            "colors": "wallpaper"}

# ---------------------------------------------------------------- small helpers


def load():
    try:
        j = json.load(open(STATE))
    except Exception:
        j = {}
    c = dict(DEFAULTS)
    c.update({k: v for k, v in j.items() if k in DEFAULTS})
    return c


def save(c):
    os.makedirs(RICE, exist_ok=True)
    tmp = STATE + ".tmp"
    json.dump(c, open(tmp, "w"), indent=1)
    os.replace(tmp, STATE)


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        if open(path).read() == text:
            return False
    except Exception:
        pass
    tmp = path + ".rice-tmp"
    open(tmp, "w").write(text)
    os.replace(tmp, path)
    return True


def read(path):
    try:
        return open(path).read()
    except Exception:
        return ""


def run(cmd, t=8, env=None):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=t, env=env).stdout
    except Exception:
        return ""


def spawn(cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                         start_new_session=True)
        return True
    except Exception:
        return False


def distro():
    s = read("/etc/os-release")
    ids = " ".join(re.findall(r'^(?:ID|ID_LIKE)="?([^"\n]*)"?', s, re.M)).lower()
    if "nixos" in ids:
        return "nixos"
    if "arch" in ids or "cachyos" in ids:
        return "arch"
    if "fedora" in ids or "rhel" in ids:
        return "fedora"
    if "debian" in ids or "ubuntu" in ids:
        return "debian"
    if "void" in ids.split():
        return "void"
    return "other"


def login_shell():
    try:
        import pwd
        return os.path.basename(pwd.getpwuid(os.getuid()).pw_shell or "")
    except Exception:
        return os.path.basename(os.environ.get("SHELL", ""))


def current_shell(c):
    if c["shell"] and shutil.which(c["shell"]):
        return c["shell"]
    # what kitty starts now (the shell's kitty.conf says fish), else your login shell
    m = re.findall(r"^\s*shell\s+(\S+)", read(CFG + "/kitty/kitty.conf"), re.M)
    if m and m[-1] != ".":
        return os.path.basename(m[-1])
    return login_shell() or "bash"


def current_term(c):
    t = read(TERMFILE).strip() or c["terminal"]
    if t and shutil.which(t):
        return t
    for x in TERMS:
        if shutil.which(x["id"]):
            return x["id"]
    return "kitty"


def mono_font():
    try:
        f = json.load(open(RICE + "/fonts.json")).get("mono")
        if f:
            return f
    except Exception:
        pass
    return "JetBrainsMono Nerd Font"


def opacity():
    """kitty's see-through background (Settings and Light mode change it): the other terminals follow it"""
    m = re.findall(r"^\s*background_opacity\s+([0-9.]+)", read(CFG + "/kitty/kitty.conf"), re.M)
    try:
        return max(0.1, min(1.0, float(m[-1]))) if m else 0.85
    except Exception:
        return 0.85


def palette():
    """the wallpaper's colors: matugen writes them for kitty on every wallpaper change"""
    s = read(CFG + "/kitty/current-theme.conf")
    p = {}
    for k, v in re.findall(r"^\s*(\w+)\s+(#[0-9a-fA-F]{6})", s, re.M):
        p[k] = v.lower()
    base = ["#1c1b1f", "#ffb4ab", "#a6d189", "#e5c890", "#8caaee", "#f4b8e4", "#81c8be", "#c6d0f5"]
    for i in range(16):
        p.setdefault("color%d" % i, base[i % 8])
    p.setdefault("foreground", p["color7"])
    p.setdefault("background", p["color0"])
    p.setdefault("cursor", p["color3"])
    p.setdefault("selection_background", p["color3"])
    p.setdefault("selection_foreground", p["color0"])
    # the roles (the kitty template: 3 = primary, 4 = secondary, 2 = tertiary)
    p["primary"], p["secondary"], p["tertiary"] = p["color3"], p["color4"], p["color2"]
    return p


def rgb(h):
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def ansi(h):
    return "38;2;%d;%d;%d" % rgb(h)


def version_of(prog):
    """"fish 4.0.2", "kitty 0.39.1" ..."""
    if not shutil.which(prog):
        return prog
    m = re.search(r"\d+(?:\.\d+)+", run([prog, "--version"], 4))
    return "%s %s" % (prog, m.group(0)) if m else prog


def wallpaper():
    out = run(["awww", "query"], 3)
    m = re.search(r"image: (.+)", out)
    w = m.group(1).strip() if m else read(HOME + "/.cache/hyprquickpaper-current").strip()
    return w if w and os.path.exists(w) else ""


# ---------------------------------------------------------------- fastfetch

