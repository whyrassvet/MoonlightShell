#!/usr/bin/env python3
import shutil
import subprocess
import time


def cpu():
    f = open("/proc/stat").readline().split()[1:]
    v = [int(x) for x in f]
    return v[3] + v[4], sum(v)


i0, t0 = cpu()
time.sleep(0.4)
i1, t1 = cpu()
c = round(100 * (1 - (i1 - i0) / (t1 - t0))) if t1 > t0 else 0
m = {}
for ln in open("/proc/meminfo"):
    k, v = ln.split(":")
    m[k] = int(v.split()[0])
r = round(100 * (m["MemTotal"] - m["MemAvailable"]) / m["MemTotal"])
g = None
if shutil.which("nvidia-smi"):
    try:
        g = int(float(subprocess.run(["nvidia-smi", "--query-gpu=utilization.gpu", "--format=csv,noheader,nounits"],
                                     capture_output=True, text=True, timeout=3).stdout.split("\n")[0]))
    except Exception:
        g = None
print("CPU %d%%  ·  RAM %d%%" % (c, r) + ("  ·  GPU %d%%" % g if g is not None else ""))
