#!/usr/bin/env bash
# the DarkShadow bar is on: there is no Waybar to reload
"$HOME/.local/bin/rice-bar" enabled 2>/dev/null && exit 0
exec 9>/tmp/waybar-reload.lock
flock -n 9 || exit 0
pkill -x waybar 2>/dev/null; pkill -x .waybar-wrapped 2>/dev/null
for i in $(seq 1 60); do
  pgrep -x .waybar-wrapped >/dev/null || pgrep -x waybar >/dev/null || break
  sleep 0.05
done
pkill -9 -x .waybar-wrapped 2>/dev/null; pkill -9 -x waybar 2>/dev/null
setsid -f waybar >/dev/null 2>&1 9>&-
sleep 0.5
