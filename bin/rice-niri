#!/usr/bin/env python3
"""rice-niri: the niri config of DarkShadow's Shell (~/.config/niri/config.kdl).

  rice-niri apply [--force]        write config.kdl again from your settings (niri reloads it by itself)
  rice-niri print                  show what would be written
  rice-niri check                  write it to a temporary file and let niri validate it
  rice-niri state                  JSON: {version, features, path, ok}

The config is made from the same settings the Settings app keeps for Hyprland (~/.config/rice/hypr.json:
gaps, borders, corners, shadows, blur, animations, keyboard, monitors, your keybinds and autostart), the
wallpaper border colors, the cursor, and the blur / gaming mode switches (rice-effects). It fits the niri you
have: newer features (blur from 26.04, include from 25.11, spawn-sh from 25.08) are only used when niri knows
them, and the result is checked with `niri validate` before it replaces the old one.

Your own niri settings go in ~/.config/niri/user.kdl: it is loaded last, so it wins, and it is never touched.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

HOME = os.path.expanduser("~")
NIRI = HOME + "/.config/niri"
OUT = NIRI + "/config.kdl"
USER = NIRI + "/user.kdl"
RICE = HOME + "/.config/rice"
CACHE = HOME + "/.cache/rice"
HYPR = HOME + "/.config/hypr"
BIN = HOME + "/.local/bin"
MARK = "// DarkShadow's Shell: generated by rice-niri"
LOG = CACHE + "/niri-config.log"

USER_TEXT = """// Your own niri settings (DarkShadow's Shell never changes this file).
// It is loaded after the shell's config, so whatever you set here wins.
// Docs: https://niri-wm.github.io/niri/Configuration%3A-Introduction.html
//
// Examples:
// input { keyboard { repeat-delay 300; repeat-rate 40; } }
// binds { Mod+B { spawn "firefox"; } }
// window-rule { match app-id="^steam$"; open-floating true; }
"""


# ---------------------------------------------------------------- what niri this is
def niri_bin():
    return shutil.which("niri")


def version():
    """(major, minor) of the installed niri, e.g. (26, 4); None when niri is not installed"""
    forced = os.environ.get("RICE_NIRI_VERSION", "")       # for testing: pretend this version
    m = re.match(r"(\d+)\.(\d+)", forced)
    if m:
        return (int(m.group(1)), int(m.group(2)))
    b = niri_bin()
    if not b:
        return None
    try:
        v = subprocess.run([b, "--version"], capture_output=True, text=True, timeout=5).stdout.split()
        m = re.match(r"(\d+)\.(\d+)", v[1] if len(v) > 1 else "")
        if m:
            return (int(m.group(1)), int(m.group(2)))
    except Exception:
        pass
    return None


class F:
    """the features this niri has"""

    def __init__(self, ver):
        v = ver or (25, 5)               # not installed yet: only what every supported niri knows
        self.ver = ver
        self.spawn_sh = v >= (25, 8)
        self.bezier = v >= (25, 8)
        self.xwls = v >= (25, 8)
        self.overlay_hide = v >= (25, 8)
        self.include = v >= (25, 11)
        self.backdrop = v >= (25, 5)
        self.blur = v >= (26, 4)
        self.optional_include = v >= (26, 4)
        self.overview = v >= (25, 5)
        self.hot_corners = v >= (25, 5)
        self.corner_pick = v >= (25, 11)        # hot-corners { top-left / ... } (before: only on or off)
        self.max_to_edges = v >= (25, 11)
        self.recent = v >= (25, 11)             # niri's own Alt + Tab switcher (recent-windows): turned off

    def json(self):
        return {k: v for k, v in self.__dict__.items() if k != "ver"}


# ---------------------------------------------------------------- the settings it reads
def jload(p, d):
    try:
        with open(p) as f:
            return json.load(f)
    except Exception:
        return d


def first_line(p):
    try:
        with open(p) as f:
            return f.read().strip().split("\n")[0].strip()
    except Exception:
        return ""


def hex6(c, d):
    c = (c or "").strip()
    if re.fullmatch(r"#?[0-9a-fA-F]{6}", c):
        return "#" + c.lstrip("#").lower()
    return d


def effects():
    c = {"lite": False, "keep_blur": False, "keep_anim": False, "keep_gaps": False, "keep_shadows": False}
    raw = jload(RICE + "/effects.json", {})
    for k in c:
        if raw.get(k) is True:
            c[k] = True
    gaming = os.path.exists(RICE + "/gaming-on")
    flat = c["lite"] or (gaming and not c["keep_blur"])
    return c, gaming, flat


def cursor():
    """the cursor theme and size (rice-cursor writes the Xcursor theme niri can draw)"""
    t = first_line(CACHE + "/xcursor").split()
    c = jload(RICE + "/cursor.json", {})
    theme = t[0] if t else (c.get("theme") or "Bibata-Modern-Ice")
    try:
        size = int(t[1]) if len(t) > 1 else int(c.get("size") or 24)
    except ValueError:
        size = 24
    return theme, max(12, min(96, size))


# ---------------------------------------------------------------- KDL helpers
def q(s):
    return json.dumps(str(s), ensure_ascii=False)


def num(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int) or (isinstance(v, float) and v.is_integer()):
        return str(int(v))
    return ("%.4f" % v).rstrip("0").rstrip(".")


def flt(v):
    """a KDL float: always with a decimal point (niri wants 1.0, not 1, where it expects a float)"""
    t = ("%.4f" % float(v)).rstrip("0")
    return t + "0" if t.endswith(".") else t


def clampf(v, lo, hi, d):
    try:
        return max(lo, min(hi, float(v)))
    except Exception:
        return d


def block(name, lines):
    """name { lines } as KDL lines (nested blocks are indented once more)"""
    return [name + " {"] + ["    " + l for l in lines] + ["}"]


# ---------------------------------------------------------------- keybinds
MOD_NAMES = {"super": "Mod", "mod": "Mod", "win": "Mod", "mod4": "Mod", "ctrl": "Ctrl", "control": "Ctrl",
             "alt": "Alt", "mod1": "Alt", "shift": "Shift"}
KEY_NAMES = {"mouse_down": "WheelScrollDown", "mouse_up": "WheelScrollUp", "mouse_left": "WheelScrollLeft",
             "mouse_right": "WheelScrollRight", "return": "Return", "enter": "Return", "space": "Space",
             "escape": "Escape", "esc": "Escape", "tab": "Tab", "print": "Print", "minus": "Minus", "equal": "Equal",
             "comma": "Comma", "period": "Period", "slash": "Slash", "backspace": "BackSpace", "delete": "Delete"}


def hypr_keys(keys):
    """'SUPER + SHIFT + R' -> 'Mod+Shift+R' (None when niri cannot bind it, e.g. mouse buttons)"""
    parts = [p.strip() for p in re.split(r"\s*\+\s*", keys.strip()) if p.strip()]
    if not parts:
        return None
    mods, key = [], parts[-1]
    for p in parts[:-1]:
        m = MOD_NAMES.get(p.lower())
        if not m:
            return None
        if m not in mods:
            mods.append(m)
    if key.lower().startswith("mouse:") or key.lower().startswith("code:"):
        return None
    key = KEY_NAMES.get(key.lower(), key)
    if len(key) == 1:
        key = key.upper()
    order = ["Mod", "Ctrl", "Alt", "Shift"]
    return "+".join(sorted(mods, key=order.index) + [key])


def norm_key(k):
    parts = k.split("+")
    return "+".join(sorted(p.lower() for p in parts[:-1]) + [parts[-1].lower()])


