# the shell's actions you gave other keys (Settings > System > Keybinds, the pencil; rice-keymap, keys.conf):
# action id -> the key niri has for it by default
ACTION_KEYS = {
    "terminal": "Mod+Return", "launcher": "Mod+D", "launcher2": "Alt+Space", "settings": "Mod+U", "wallpaper": "Mod+W",
    "quick": "Mod+A", "cc": "Mod+N", "gamebar": "Mod+G", "dashboard": "Mod+Alt+D", "lock": "Mod+L", "close": "Mod+Q",
    "float": "Mod+Shift+V", "clipboard": "Mod+V", "shot": "Print", "shotfull": "Shift+Print", "record": "Mod+Shift+R", "widgets": "Mod+Alt+W",
    "taskview": "Mod+Tab", "switcher": "Alt+Tab",
}


def action_keys():
    """{niri default key (normalized): your key} from ~/.config/rice/keys.conf"""
    out = {}
    try:
        for line in open(RICE + "/keys.conf"):
            m = re.match(r"^\s*(\w+)\s*=\s*(.*?)\s*$", line)
            if m and m.group(1) in ACTION_KEYS and m.group(2):
                k = hypr_keys(m.group(2))
                if k:
                    out[norm_key(ACTION_KEYS[m.group(1)])] = k
    except OSError:
        pass
    return out


def infinite_binds():
    """Infinite Desktop on niri (rice-canvasd moves the floating windows): on / off, your keys + arrows move the
    canvas, your other keys + arrows go to the next window. Your keys come from ~/.config/rice/infinite.conf"""
    k = {"key_toggle": "SUPER + ALT + F", "mod_hold": "SUPER + ALT", "mod_go": "SUPER + ALT + SHIFT"}
    pan = 180
    try:
        for line in open(RICE + "/infinite.conf"):
            m = re.match(r"^\s*(\w+)\s*=\s*(.*?)\s*$", line)
            if m and m.group(1) in k and m.group(2):
                k[m.group(1)] = m.group(2)
            elif m and m.group(1) == "pan":
                try:
                    pan = int(float(m.group(2)))
                except ValueError:
                    pass
    except OSError:
        pass
    b = BIN + "/rice-infinite"
    out = []
    t = hypr_keys(k["key_toggle"])
    if t:
        out.append((t, 'hotkey-overlay-title="Infinite Desktop on / off"', "spawn %s %s;" % (q(b), q("toggle"))))
    for key, dx, dy in (("Left", pan, 0), ("Right", -pan, 0), ("Up", 0, pan), ("Down", 0, -pan)):
        h = hypr_keys(k["mod_hold"] + " + " + key)
        if h:
            out.append((h, "hotkey-overlay-title=null", "spawn %s %s %s %s;" % (q(b), q("pan"), q(str(dx)), q(str(dy)))))
    for key in ("Left", "Right", "Up", "Down"):
        g = hypr_keys(k["mod_go"] + " + " + key)
        if g:
            out.append((g, "hotkey-overlay-title=null", "spawn %s %s %s;" % (q(b), q("go"), q(key.lower()))))
    return out


def binds_section(f, s, term, files):
    custom = []
    for bd in s.get("binds") or []:
        k = hypr_keys(str(bd.get("keys", "")))
        cmd = str(bd.get("cmd", "")).strip()
        if k and cmd:
            custom.append((k, "", ("spawn-sh %s;" % q(cmd)) if f.spawn_sh else ("spawn \"sh\" \"-c\" %s;" % q(cmd))))
    # your keys for the shell's actions: the action moves to the new key (and comes before the other defaults, so
    # a default on that key gives way: niri refuses a config with one key twice)
    moved, rest, ak = [], [], action_keys()
    for k, props, act in default_binds(f, term, files):
        nk = norm_key(k)
        if nk in ak:
            moved.append((ak[nk], props, act))
        else:
            rest.append((k, props, act))
    seen, lines = set(), []
    # Infinite Desktop's keys come after yours and the actions you moved, before niri's defaults (a default on the
    # same key gives way to the key you chose for Infinite Desktop)
    # Infinite Desktop is Hyprland only (V4.23): no keys for it here
    for k, props, act in custom + moved + rest:       # yours first: they replace the shell's
        nk = norm_key(k)
        if nk in seen:
            continue
        seen.add(nk)
        lines.append("%s%s { %s }" % (k, (" " + props) if props else "", act))
    return block("binds", lines)


# ---------------------------------------------------------------- the parts of the config
MOTION = {
    # name: (open, close, springs {workspace, view, move, resize, overview})
    "calm": (("cubic", 320, (0.05, 0.7, 0.1, 1.0)), ("cubic", 200, (0.3, 0.0, 0.8, 0.15)),
             {"ws": (1.0, 700), "view": (1.0, 700), "move": (1.0, 700), "resize": (1.0, 700), "ov": (1.0, 700)}),
    "lively": (("cubic", 360, (0.05, 0.7, 0.1, 1.0)), ("cubic", 200, (0.3, 0.0, 0.8, 0.15)),
               {"ws": (0.85, 800), "view": (0.85, 800), "move": (0.8, 800), "resize": (0.85, 800), "ov": (0.85, 800)}),
    # Fluid: Material 3 emphasized decelerate in, accelerate out, unhurried springs that never overshoot
    "fluid": (("cubic", 440, (0.05, 0.7, 0.1, 1.0)), ("cubic", 180, (0.3, 0.0, 0.8, 0.15)),
              {"ws": (1.0, 520), "view": (1.0, 520), "move": (1.0, 560), "resize": (1.0, 560), "ov": (1.0, 520)}),
    # Expressive: Material 3 expressive springs: a hint of overshoot where things move, a soft pop when they open
    "expressive": (("cubic", 480, (0.2, 1.22, 0.4, 1.0)), ("cubic", 180, (0.3, 0.0, 0.8, 0.15)),
                   {"ws": (0.8, 700), "view": (0.8, 700), "move": (0.75, 640), "resize": (0.8, 700), "ov": (0.85, 640)}),
    "snappy": (("ease-out-expo", 160, None), ("ease-out-quad", 120, None),
               {"ws": (1.0, 1200), "view": (1.0, 1200), "move": (1.0, 1200), "resize": (1.0, 1200), "ov": (1.0, 1200)}),
    "minimal": (("ease-out-quad", 150, None), ("ease-out-quad", 120, None),
                {"ws": (1.0, 1000), "view": (1.0, 1000), "move": (1.0, 1000), "resize": (1.0, 1000), "ov": (1.0, 1000)}),
}


def easing(f, kind, ms, pts):
    if kind == "cubic":
        if f.bezier:
            return ["duration-ms %d" % ms, 'curve "cubic-bezier" %s' % " ".join(flt(p) for p in pts)]
        return ["duration-ms %d" % ms, 'curve "ease-out-expo"']
    return ["duration-ms %d" % ms, 'curve "%s"' % kind]


def spring(d, k):
    return ["spring damping-ratio=%s stiffness=%d epsilon=0.0001" % (flt(d), k)]


def animations(f, s, gaming, fx):
    a = s.get("anim") or {}
    if a.get("enabled") is False or (gaming and not fx["keep_anim"]):
        return block("animations", ["off"])
    style = a.get("style", "calm")
    style = {"bouncy": "expressive"}.get(style, style)      # Bouncy (V3.97 and older) is now Expressive
    op, cl, sp = MOTION.get(style, MOTION["calm"])
    pct = clampf(a.get("speed", 100), 50, 200, 100)
    L = []
    if abs(pct - 100) > 0.5:
        L.append("slowdown %s" % flt(round(100.0 / pct, 3)))
    L += block("workspace-switch", spring(*sp["ws"]))
    L += block("window-open", easing(f, *op))
    L += block("window-close", easing(f, *cl))
    L += block("horizontal-view-movement", spring(*sp["view"]))
    L += block("window-movement", spring(*sp["move"]))
    L += block("window-resize", spring(*sp["resize"]))
    if f.overview:
        L += block("overview-open-close", spring(*sp["ov"]))
    return block("animations", L)


def opt(s, key, d):
    v = (s.get("opts") or {}).get(key)
    return d if v is None else v


def layout(f, s, gaming, fx, flat, colors):
    gi = int(clampf(opt(s, "general.gaps_in", 4), 0, 60, 4))
    go = int(clampf(opt(s, "general.gaps_out", 6), 0, 100, 6))
    if gaming and not fx["keep_gaps"]:
        gi = go = 0
    gaps = gi * 2
    strut = max(0, go - gaps)
    bw = int(clampf(opt(s, "general.border_size", 2), 0, 12, 2))
    c1, c2, inactive = colors
    L = ["gaps %d" % gaps, 'center-focused-column "never"', "always-center-single-column",
         # transparent workspaces: the wallpaper (in the backdrop, see the layer rules) shows behind the windows,
         # stays still while you switch workspaces and is seen in the overview too
         'background-color "transparent"']
    L += block("preset-column-widths", ["proportion 0.33333", "proportion 0.5", "proportion 0.66667", "proportion 1.0"])
    L += block("default-column-width", ["proportion 0.5"])
    L += block("focus-ring", ["off"])
    if bw > 0:
        L += block("border", ["width %d" % bw,
                              'active-gradient from=%s to=%s angle=45 relative-to="workspace-view"' % (q(c1), q(c2)),
                              "inactive-color %s" % q(inactive), 'urgent-color "#ff8a80"'])
    else:
        L += block("border", ["off"])
    sh_on = bool(opt(s, "decoration.shadow.enabled", False))
    if fx["lite"] or (gaming and not fx["keep_shadows"]):
        sh_on = False
    rng = int(clampf(opt(s, "decoration.shadow.range", 12), 0, 60, 12))
    alpha = int(round(clampf(s.get("shadow_int", 60), 0, 100, 60) * 2.55))
    if sh_on:          # niri draws no window shadows unless asked to ("off" is not known before 25.11)
        L += block("shadow", ["on", "softness %d" % max(4, rng * 2), "spread %d" % max(0, rng // 3),
                              "offset x=0 y=%d" % max(2, rng // 3), "color %s" % q("#000000%02x" % alpha)])
    if strut:
        L += block("struts", ["left %d" % strut, "right %d" % strut, "top %d" % strut, "bottom %d" % strut])
    return block("layout", L)


def input_section(s):
    k = s.get("kbd") or {}
    xkb = []
    if k.get("layouts"):
        xkb.append("layout %s" % q(k["layouts"]))
    if k.get("variants"):
        xkb.append("variant %s" % q(k["variants"]))
    if k.get("options"):
        xkb.append("options %s" % q(k["options"]))
    kb = block("xkb", xkb) + ["numlock"]
    if (k.get("layouts") or "").count(",") > 0:
        kb.append('track-layout "global"')
    sens = clampf(opt(s, "input.sensitivity", 0), -1, 1, 0)
    mouse = ["accel-speed %s" % flt(round(sens, 3))]
    if opt(s, "input.natural_scroll", False):
        mouse.append("natural-scroll")
    sf = clampf(opt(s, "input.scroll_factor", 1), 0.2, 3, 1)
    if abs(sf - 1) > 0.01:
        mouse.append("scroll-factor %s" % flt(round(sf, 2)))
    tp = ["accel-speed %s" % flt(round(sens, 3))]
    if opt(s, "input.touchpad.tap-to-click", True):
        tp.append("tap")
    if opt(s, "input.touchpad.natural_scroll", True):
        tp.append("natural-scroll")
    tsf = clampf(opt(s, "input.touchpad.scroll_factor", 1), 0.2, 3, 1)
    if abs(tsf - 1) > 0.01:
        tp.append("scroll-factor %s" % flt(round(tsf, 2)))
    tp.append("dwt")
    L = block("keyboard", kb) + block("mouse", mouse) + block("touchpad", tp)
    # like Hyprland's follow_mouse = 1 (off by default in niri: it is easy to lose focus by accident)
    L += ["focus-follows-mouse max-scroll-amount=\"0%\"", "warp-mouse-to-focus"]
    return block("input", L)


def known_outputs():
    """the screens niri has (asked now when niri runs, else the ones seen before): ~/.config/rice/niri-outputs.json"""
    p = RICE + "/niri-outputs.json"
    seen = jload(p, [])
    if not isinstance(seen, list):
        seen = []
    sock = os.environ.get("NIRI_SOCKET", "")
    if (sock and os.path.exists(sock)) and niri_bin():
        try:
            r = subprocess.run([niri_bin(), "msg", "-j", "outputs"], capture_output=True, text=True, timeout=4)
            names = sorted(json.loads(r.stdout).keys())
            new = sorted(set(seen) | set(names))
            if new != sorted(seen):
                os.makedirs(RICE, exist_ok=True)
                with open(p, "w") as fh:
                    json.dump(new, fh)
            seen = new
        except Exception:
            pass
    return [n for n in seen if re.fullmatch(r"[A-Za-z0-9_.:-]+", str(n))]


def outputs(s):
    L = []
    mons = s.get("monitors") or {}
    # a screen you did not set up in Settings > System > Screen gets size 100 %, like on Hyprland (niri would pick
    # a bigger size by itself on sharp laptop screens, often 150 %)
    for name in known_outputs():
        if name not in mons:
            L += block("output %s" % q(name), ["scale 1.0"])
    for name, m in mons.items():
        if not re.fullmatch(r"[A-Za-z0-9_.:-]+", name):
            continue
        if m.get("disabled"):
            L += block("output %s" % q(name), ["off"])
            continue
        body = []
        mm = re.match(r"(\d+)x(\d+)@([\d.]+)", str(m.get("mode", "")))
        if mm:
            body.append('mode "%sx%s@%.3f"' % (mm.group(1), mm.group(2), float(mm.group(3))))
        try:
            body.append("scale %s" % flt(round(float(m.get("scale", 1)), 3)))
        except Exception:
            pass
        pm = re.match(r"(-?\d+)x(-?\d+)$", str(m.get("position", "")))
        if pm:
            body.append("position x=%s y=%s" % (pm.group(1), pm.group(2)))
        try:
            tr = int(m.get("transform", 0) or 0) % 4
        except Exception:
            tr = 0
        if tr:
            body.append('transform "%s"' % ["normal", "90", "180", "270"][tr])
        L += block("output %s" % q(name), body)
    return L


def window_rules(f, s, flat):
    rad = int(clampf(opt(s, "decoration.rounding", 9), 0, 40, 9))
    L = []
    # every window: your corner radius, clipped so nothing sticks out
    L += block("window-rule", ["geometry-corner-radius %d" % rad, "clip-to-geometry true",
                               "draw-border-with-background false"])
    if not flat:
        ao = clampf(opt(s, "decoration.active_opacity", 1), 0.1, 1, 1)
        io = clampf(opt(s, "decoration.inactive_opacity", 1), 0.1, 1, 1)
        if ao < 0.999:
            L += block("window-rule", ["match is-active=true", "opacity %s" % flt(round(ao, 3))])
        if io < 0.999:
            L += block("window-rule", ["match is-active=false", "opacity %s" % flt(round(io, 3))])
        # see-through, blurred Files (like on Hyprland) and a blurred terminal
        L += block("window-rule", ['match app-id="^org\\\\.gnome\\\\.Nautilus$"', "opacity 0.92"] +
                   (block("background-effect", ["blur true"]) if f.blur else []))
        if f.blur:
            L += block("window-rule", ['match app-id="^(kitty|foot|footclient|Alacritty|com\\\\.mitchellh\\\\.ghostty|org\\\\.wezfurlong\\\\.wezterm)$"'] +
                       block("background-effect", ["blur true"]))
            # the Settings app: frosted like on Hyprland
            L += block("window-rule", ['match title="^Rice Settings$"'] + block("background-effect", ["blur true", "xray true"]))
    # pop-up apps float in the middle, like on Hyprland
    floats = [
        ('title="^Rice Settings$"', None),
        ('app-id="^org\\\\.pulseaudio\\\\.pavucontrol$"', (900, 650)),
        ('app-id="^io\\\\.github\\\\.kaii_lb\\\\.Overskride$"', (900, 650)),
        ('app-id="^waypaper$"', (900, 650)),
        ('app-id="^gsimplecal$"', None),
        ('app-id="^nmtui$"', (800, 500)),
        ('app-id="[Zz]enity"', None),
        ('app-id="^org\\\\.gnome\\\\.Calendar$"', (900, 650)),
        ('app-id="^hyprland-run$"', None),
        ('app-id="^xdg-desktop-portal"', None),
        ('title="^Picture.in.[Pp]icture$"', None),
    ]
    for match, size in floats:
        body = ["match " + match, "open-floating true"]
        if size:
            body += block("default-column-width", ["fixed %d" % size[0]])
            body += ["default-window-height { fixed %d; }" % size[1]]
        L += block("window-rule", body)
    # Picture-in-Picture stays in a corner
    L += block("window-rule", ['match title="^Picture.in.[Pp]icture$"',
                               'default-floating-position x=32 y=32 relative-to="bottom-right"'])
    return L


def layer_rules(f, flat):
    L = []
    # the overview (SUPER + Tab): the shell's blurred wallpaper (rice-backdrop) behind the zoomed-out workspaces;
    # the workspaces keep the sharp wallpaper (awww)
    if f.backdrop:
        L += block("layer-rule", ['match namespace="^rice-backdrop$"', "place-within-backdrop true"])
    # full-screen layers that animate themselves get no shadow
    L += block("layer-rule", ['match namespace="^rice-(welcome|tour-dim)$"', "shadow { off; }"])
    # blur that shows what is behind the shell (windows too), not only the wallpaper: xray off for the shell's layers
    # (the bar / Dynamic Island, menus, dock ...); the blur region itself still comes from the shell.
    # The desktop widgets keep xray: they sit on the wallpaper under every window, and the experimental non-xray blur
    # did not show behind them at all
    # Every layer of the shell blurs what is behind it, windows too (non-xray). The bar and the Dynamic Island need
    # it most: in the overview (Win + Tab) and while workspaces slide, windows pass behind them, and with xray
    # (wallpaper only) the windows showed through the bar unblurred, like a hole. Only the small area behind each
    # surface is blurred, so it costs little. The desktop widgets are different: they sit on the wallpaper under every window, so their blur is the shared one.
    if f.blur and not flat:
        L += block("layer-rule", ['match namespace="^rice-(bar|bluetooth|cc|clipboard|deskmenu|dock|dock-apps|gamebar|hotcorner|launcher|notify-popup|power|volume|osd|taskview|wallum|walls|wifi)$"']
                   + block("background-effect", ["xray false"]))
    # blur: the shell asks niri for blur exactly where it draws (Quickshell, ext-background-effect), so no layer
    # gets a rule here: a rule would blur a whole surface, see-through margins included
    return L


def startup(f, s):
    b = BIN + "/"
    cmds = [
        # this config again, for exactly this niri (it is only rewritten when something changed)
        b + "rice-niri apply",
        # the session knows it runs niri (portals, xdg-desktop-autostart)
        "systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP NIRI_SOCKET DISPLAY 2>/dev/null; "
        "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP NIRI_SOCKET DISPLAY 2>/dev/null",
        # without systemd (Void): PipeWire and the password prompt agent
        b + "rice-sys session",
        "awww-daemon",
        b + "rice-notifyd",
        "hypridle",
        b + "rice-bar start",
        b + "rice-desktop start",
        b + "rice-cursor restore",
        # Infinite Desktop: hold your keys (SUPER + ALT) and move the mouse; new windows float while it is on
        b + "rice-infinite daemon",
        # a password prompt for apps that need admin rights
        "systemctl --user start hyprpolkitagent.service 2>/dev/null || "
        "{ for a in /usr/lib/hyprpolkitagent/hyprpolkitagent /usr/libexec/hyprpolkitagent /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 "
        "/usr/libexec/polkit-gnome-authentication-agent-1 /usr/lib/polkit-kde-authentication-agent-1; do [ -x \"$a\" ] && exec \"$a\"; done; "
        "command -v hyprpolkitagent >/dev/null && exec hyprpolkitagent; }",
    ]
    # your autostart (Settings > Autostart); Hyprland-only ones are left out
    for c in s.get("autostart") or []:
        c = str(c).strip()
        if c and "hyprland-session" not in c and not c.startswith("hyprctl"):
            cmds.append(c)
    L = []
    for c in cmds:
        L.append(("spawn-sh-at-startup %s" % q(c)) if f.spawn_sh else ('spawn-at-startup "sh" "-c" %s' % q(c)))
    return L


def misc(f, gaming, fx, flat):
    theme, size = cursor()
    L = ["prefer-no-csd", 'screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"']
    L += block("hotkey-overlay", ["skip-at-startup"] + (["hide-not-bound"] if f.overlay_hide else []))
    L += block("cursor", ["xcursor-theme %s" % q(theme), "xcursor-size %d" % size, "hide-when-typing"])
    L += block("environment", ['ELECTRON_OZONE_PLATFORM_HINT "auto"', 'QT_QPA_PLATFORM "wayland;xcb"',
                               'QT_WAYLAND_DISABLE_WINDOWDECORATION "1"', 'MOZ_ENABLE_WAYLAND "1"',
                               'XDG_CURRENT_DESKTOP "niri"', 'XDG_SESSION_TYPE "wayland"'])
    if f.overview:
        L += block("overview", ["zoom 0.5", 'backdrop-color "#101114"'] +
                   block("workspace-shadow", ["softness 40", "spread 10", "offset x=0 y=10", 'color "#00000050"']))
    if f.hot_corners:
        # niri's own hot corner (top left: the overview), unless the shell's hot corner sits there
        hc = jload(RICE + "/hotcorner.json", {})
        ours = hc.get("corner", "bottom-right") if hc.get("enabled", True) is not False else ""
        if ours == "top-left":
            L += block("gestures", block("hot-corners", ["off"]))
        elif f.corner_pick:
            L += block("gestures", block("hot-corners", ["top-left"]))
    if f.blur:
        s = jload(RICE + "/hypr.json", {})
        if flat or not opt(s, "decoration.blur.enabled", True):
            L += block("blur", ["off"])
        else:
            size_ = clampf(opt(s, "decoration.blur.size", 8), 1, 30, 8)
            passes = int(clampf(opt(s, "decoration.blur.passes", 3), 1, 6, 3))
            # no grain unless you ask for it (niri adds 0.02 by default: on dark wallpapers it looked pixelated)
            noise = clampf(opt(s, "decoration.blur.noise", 0.0), 0, 0.5, 0.0)
            vib = clampf(opt(s, "decoration.blur.vibrancy", 0.17), 0, 1, 0.17)
            L += block("blur", ["passes %d" % passes, "offset %s" % flt(round(max(1.0, min(6.0, size_ / 3.0)), 2)),
                                "noise %s" % flt(round(noise, 3)), "saturation %s" % flt(round(1.0 + vib * 3, 2))])
    return L


def colors(s):
    """border colors: yours (Settings > Desktop > Windows) or the ones from the wallpaper"""
    b = s.get("borders") or {}
    if b.get("mode") == "custom" or os.path.exists(RICE + "/border-custom"):
        a = hex6(b.get("active"), "#f6f5f4")
        return a, a, hex6(b.get("inactive"), "#444444")
    try:
        c = open(HYPR + "/border-colors.txt").read().split()
    except Exception:
        c = []
    c1 = hex6(c[0] if c else "", "#a8c7fa")
    c2 = hex6(c[1] if len(c) > 1 else "", c1)
    return c1, c2, "#59595980"


def terminal():
    # your terminal (Settings > Desktop > Look & Feel): rice-term opens the one you picked
    if os.access(BIN + "/rice-term", os.X_OK):
        return BIN + "/rice-term"
    for t in ("kitty", "foot", "alacritty", "ghostty", "wezterm"):
        if shutil.which(t):
            return t
    return "kitty"


def files_app():
    for t in ("nautilus", "dolphin", "thunar", "nemo"):
        if shutil.which(t):
            return t
    return "nautilus"


def build(f, user=True):
    s = jload(RICE + "/hypr.json", {})
    fx, gaming, flat = effects()
    L = [MARK + ". Do not edit: your changes go in user.kdl.",
         "// Change it from the Settings app (SUPER + U) or run: rice-niri apply",
         "// niri %s" % (".".join(str(x) for x in f.ver) if f.ver else "(not found while writing)"), ""]
    L += input_section(s) + [""]
    L += outputs(s) + [""]
    L += layout(f, s, gaming, fx, flat, colors(s)) + [""]
    L += misc(f, gaming, fx, flat) + [""]
    L += startup(f, s) + [""]
    L += animations(f, s, gaming, fx) + [""]
    L += window_rules(f, s, flat) + [""]
    L += layer_rules(f, flat) + [""]
    L += binds_section(f, s, terminal(), files_app()) + [""]
    if f.recent:
        # niri's own Alt + Tab switcher is off: Alt + Tab is the shell's (rice-taskview)
        L += block("recent-windows", ["off"]) + [""]
    if not user:
        L.append("// (user.kdl is left out: niri did not accept it, see ~/.cache/rice/niri-config.log)")
    elif f.include:
        L.append("// your own settings (loaded last, so they win)")
        L.append(('include optional=true "user.kdl"' if f.optional_include else 'include "user.kdl"'))
    else:
        try:
            u = open(USER).read()
        except Exception:
            u = ""
        if u.strip():
            L += ["// your own settings, from user.kdl (this niri cannot include files)", u.rstrip("\n")]
    return "\n".join(L) + "\n"


# ---------------------------------------------------------------- writing and checking
def log(msg):
    try:
        os.makedirs(CACHE, exist_ok=True)
        with open(LOG, "a") as fh:
            fh.write(msg.rstrip("\n") + "\n")
    except Exception:
        pass


def validate(text):
    """(ok, message): niri's own check of the text (True when niri is not installed: nothing to check with)"""
    b = niri_bin()
    if not b:
        return True, "niri is not installed"
    os.makedirs(NIRI, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".rice-check-", suffix=".kdl", dir=NIRI)   # next to user.kdl (include)
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
        r = subprocess.run([b, "validate", "-c", tmp], capture_output=True, text=True, timeout=15)
        return r.returncode == 0, (r.stdout + r.stderr).strip()
    except Exception as e:
        return True, "could not run niri validate: %s" % e
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass


def ensure_user():
    os.makedirs(NIRI, exist_ok=True)
    if not os.path.exists(USER):
        with open(USER, "w") as fh:
            fh.write(USER_TEXT)


def keep_theirs():
    """a config.kdl someone wrote by hand is kept (once) before the shell's replaces it"""
    try:
        cur = open(OUT).read()
    except Exception:
        return
    if MARK not in cur and cur.strip():
        bak = NIRI + "/config.kdl.before-darkshadow"
        if not os.path.exists(bak):
            shutil.copy2(OUT, bak)
            log("your old config.kdl is kept as " + bak)


def apply(force=False):
    ensure_user()
    ver = version()
    f = F(ver)
    text = build(f)
    try:
        cur = open(OUT).read()
    except Exception:
        cur = ""
    if text == cur and not force:
        return True
    ok, msg = validate(text)
    if not ok:
        log("the new config did not pass niri validate:\n" + msg)
        # 1. the same without user.kdl (the most likely culprit), 2. only what every supported niri knows
        safe = F((25, 5) if ver and ver >= (25, 5) else ver)
        for cand in (build(f, user=False), build(safe, user=False)):
            ok, msg = validate(cand)
            if ok:
                text = cand
                break
            log("the safer config did not pass either:\n" + msg)
        if not ok:
            print("rice-niri: niri did not accept the config, the old one stays. See " + LOG, file=sys.stderr)
            return False
    keep_theirs()
    tmp = OUT + ".rice-new"
    with open(tmp, "w") as fh:
        fh.write(text)
    os.replace(tmp, OUT)            # niri watches the file and loads it again
    return True


def main(a):
    c = a[1] if len(a) > 1 else "apply"
    if c == "apply":
        sys.exit(0 if apply(force="--force" in a) else 1)
    elif c == "print":
        sys.stdout.write(build(F(version())))
    elif c == "check":
        ok, msg = validate(build(F(version())))
        print(msg or ("ok" if ok else "failed"))
        sys.exit(0 if ok else 1)
    elif c == "state":
        ver = version()
        try:
            ours = MARK in open(OUT).read()
        except Exception:
            ours = False
        print(json.dumps({"version": ".".join(str(x) for x in ver) if ver else "", "features": F(ver).json(),
                          "path": OUT, "ours": ours}))
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
