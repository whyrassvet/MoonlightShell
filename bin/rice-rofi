#!/usr/bin/env python3
"""rice-rofi: the settings of the DarkShadow Launcher (Settings > Launcher). The name stays from the days of Rofi,
which is not used any more; apply also takes the old Rofi theme out of rofi's config.

  rice-rofi state            JSON for the settings app and the launcher
  rice-rofi set KEY VALUE    change one option (theme, layout, position, width, radius,
                             transparency, opacity, blur, icons, font_size, lines)
  rice-rofi apply            write the blur rules of the launcher, the bar and its menus (rice-rofi.lua)
  rice-rofi reset            back to defaults
  rice-rofi restore          put the original rofi/Hyprland files back
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
CFG = DIR + "/rofi.json"
FONTS = DIR + "/fonts.json"
ROFI = HOME + "/.config/rofi"
THEME = ROFI + "/shadows.rasi"
ROFI_CFG = ROFI + "/config.rasi"
HYPR = HOME + "/.config/hypr"
LUA = HYPR + "/rice-rofi.lua"
HLUA = HYPR + "/hyprland.lua"
MARK = "/* rice-rofi */"

DEFAULTS = {
    "theme": "shadow", "layout": "list", "position": "center", "width": 620, "radius": 18,
    "transparency": True, "opacity": 0.82, "blur": True, "icons": True, "font_size": 13, "lines": 8,
}
RANGES = {"width": (360, 1200), "radius": (0, 32), "opacity": (0.3, 1.0), "font_size": (9, 20), "lines": (3, 14)}
CHOICES = {"layout": ["list", "grid", "bar", "split"], "position": ["top", "center", "bottom"]}
BOOLS = ("transparency", "blur", "icons")

# bg = window, alt = input/field, sel = selected row, fg = text, dim = secondary text
THEMES = {
    "shadow":   {"name": "Shadow",   "bg": "#0d0d0d", "alt": "#1a1a1a", "fg": "#F6F5F4", "dim": "#8a8a8a", "sel": "#F6F5F4", "selfg": "#0d0d0d", "bd": "#ffffff1a"},
    "graphite": {"name": "Graphite", "bg": "#18181c", "alt": "#24242a", "fg": "#ececf1", "dim": "#8e8e9a", "sel": "#3b3b48", "selfg": "#ffffff", "bd": "#ffffff1a"},
    "midnight": {"name": "Midnight", "bg": "#0b1020", "alt": "#151c33", "fg": "#e6e9f5", "dim": "#7f89ad", "sel": "#8b7bff", "selfg": "#0b1020", "bd": "#8b7bff33"},
    "rose":     {"name": "Rose",     "bg": "#1a1216", "alt": "#271a20", "fg": "#f7e9ee", "dim": "#a98a96", "sel": "#ff8fa3", "selfg": "#2a0f17", "bd": "#ff8fa333"},
    "paper":    {"name": "Paper",    "bg": "#f4f2ee", "alt": "#e6e3dc", "fg": "#1c1c1c", "dim": "#6f6c66", "sel": "#1c1c1c", "selfg": "#f4f2ee", "bd": "#0000001f"},
}


def die(m):
    sys.stderr.write(m + "\n")
    sys.exit(1)


def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def load():
    c = dict(DEFAULTS)
    try:
        raw = json.load(open(CFG))
    except Exception:
        raw = {}
    for k, d in DEFAULTS.items():
        v = raw.get(k, d)
        if k in BOOLS:
            c[k] = v is True
        elif k == "theme":
            c[k] = v if v in THEMES else d
        elif k in CHOICES:
            c[k] = v if v in CHOICES[k] else d
        elif k == "opacity":
            try:
                c[k] = round(clamp(float(v), *RANGES[k]), 2)
            except Exception:
                c[k] = d
        else:
            try:
                c[k] = int(clamp(float(v), *RANGES[k]))
            except Exception:
                c[k] = d
    return c


def save(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = CFG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(c, f)
    os.replace(tmp, CFG)


def font_family():
    try:
        f = json.load(open(FONTS))
        return f.get("mono") or f.get("main") or "JetBrainsMono Nerd Font"
    except Exception:
        return "JetBrainsMono Nerd Font"


def flat():
    """rice-effects: blur and transparency are off right now (Lite, or gaming mode)"""
    return os.path.exists(os.path.expanduser("~/.cache/rice/flat"))


def lua_text(c):
    out = ["-- generated by rice-rofi (Settings > Launcher). Do not edit by hand.\n"]
    if c["blur"]:
        out.append('hl.layer_rule({\n    name  = "rice-launcher-blur",\n    match = { namespace = "rice-launcher" },\n'
                   '    blur = true,\n    ignore_alpha = 0.1,\n})\n')
    # the Quickshell bar (rice-bar) blurs the same way
    out.append('hl.layer_rule({\n    name  = "rice-bar-blur",\n    match = { namespace = "rice-bar" },\n'
               '    blur = true,\n    ignore_alpha = 0.25,\n})\n')
    # the wallpaper picker: the sheet is blurred, the dim scrim around it is not
    out.append('hl.layer_rule({\n    name  = "rice-walls-blur",\n    match = { namespace = "rice-walls" },\n'
               '    blur = true,\n    ignore_alpha = 0.4,\n})\n')
    # the Task view: the whole screen behind it is blurred
    out.append('hl.layer_rule({\n    name  = "rice-taskview-blur",\n    match = { namespace = "rice-taskview" },\n'
               '    blur = true,\n    ignore_alpha = 0,\n})\n')
    # the clipboard: its card is blurred
    out.append('hl.layer_rule({\n    name  = "rice-clipboard-blur",\n    match = { namespace = "rice-clipboard" },\n'
               '    blur = true,\n    ignore_alpha = 0.1,\n})\n')
    out.append('hl.layer_rule({\n    name  = "rice-wifi-blur",\n    match = { namespace = "rice-wifi" },\n'
               '    blur = true,\n    ignore_alpha = 0.1,\n})\n')
    out.append('hl.layer_rule({\n    name  = "rice-bluetooth-blur",\n    match = { namespace = "rice-bluetooth" },\n'
               '    blur = true,\n    ignore_alpha = 0.1,\n})\n')
    out.append('hl.layer_rule({\n    name  = "rice-power-blur",\n    match = { namespace = "rice-power" },\n'
               '    blur = true,\n    ignore_alpha = 0.1,\n})\n')
    out.append('hl.layer_rule({\n    name  = "rice-volume-blur",\n    match = { namespace = "rice-volume" },\n'
               '    blur = true,\n    ignore_alpha = 0.1,\n})\n')
    out.append('hl.layer_rule({\n    name  = "rice-osd-blur",\n    match = { namespace = "rice-osd" },\n'
               '    blur = true,\n    ignore_alpha = 0.1,\n})\n')
    # the game bar: only the panel blurs, not the light dim over the game (that one is below ignore_alpha)
    out.append('hl.layer_rule({\n    name  = "rice-gamebar-blur",\n    match = { namespace = "rice-gamebar" },\n'
               '    blur = true,\n    ignore_alpha = 0.5,\n})\n')
    return "".join(out)


def backup_once(path, suffix):
    b = path + suffix
    if os.path.exists(path) and not os.path.exists(b):
        shutil.copy2(path, b)


def unwire_rofi():
    """Rofi is not used any more: take our theme out of rofi's config (the lines we turned off come back)"""
    if os.path.exists(ROFI_CFG):
        s = open(ROFI_CFG).read()
        lines = []
        for ln in s.splitlines():
            if MARK in ln:
                continue
            if ln.startswith("// rice-rofi disabled: "):
                ln = ln[len("// rice-rofi disabled: "):]
            lines.append(ln)
        new = "\n".join(lines) + ("\n" if lines else "")
        if new != s:
            open(ROFI_CFG, "w").write(new)
    if os.path.exists(THEME):
        os.remove(THEME)


def wire_hypr():
    """Remove the old static rofi blur rule (we control it now) and require rice-rofi. Returns True if changed."""
    if not os.path.exists(HLUA):
        return False
    s = open(HLUA).read()
    n = s
    n = re.sub(r'hl\.layer_rule\(\{\s*name\s*=\s*"rofi-blur",.*?\}\)\n?\n?', "", n, flags=re.S)
    if 'require("rice-rofi")' not in n:
        a = 'require("rice-settings")'
        if n.count(a) == 1:
            n = n.replace(a, a + '\nrequire("rice-rofi")')
        else:
            n = n.rstrip("\n") + '\n\nrequire("rice-rofi")\n'
    if n != s:
        backup_once(HLUA, ".bak-rofi")
        open(HLUA, "w").write(n)
        return True
    return False


def apply(c, reload_hypr=False):
    unwire_rofi()
    old = open(LUA).read() if os.path.exists(LUA) else None
    new = lua_text(c)
    changed = (old != new)
    if changed:
        open(LUA, "w").write(new)
    if wire_hypr():
        changed = True
    if changed or reload_hypr:
        subprocess.run([os.path.expanduser("~/.local/bin/rice-wm"), "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)


def state():
    c = load()
    out = dict(c)
    out["themes"] = {k: dict(v) for k, v in THEMES.items()}
    out["font"] = font_family()
    try:
        out["wallpaper"] = open(HOME + "/.cache/hyprquickpaper-current").read().strip()
    except Exception:
        out["wallpaper"] = ""
    print(json.dumps(out))


def setkey(k, v):
    if k not in DEFAULTS:
        die("unknown key: " + k)
    c = load()
    if k in BOOLS:
        c[k] = str(v).lower() in ("1", "true", "on", "yes")
    elif k == "theme":
        if v not in THEMES:
            die("theme: " + "|".join(THEMES))
        c[k] = v
    elif k in CHOICES:
        if v not in CHOICES[k]:
            die("%s: %s" % (k, "|".join(CHOICES[k])))
        c[k] = v
    elif k == "opacity":
        c[k] = round(clamp(float(v), *RANGES[k]), 2)
    else:
        c[k] = int(clamp(float(v), *RANGES[k]))
    save(c)
    apply(c)


def restore():
    for path, suf in ((ROFI_CFG, ".bak-rice-rofi"), (HLUA, ".bak-rofi")):
        if os.path.exists(path + suf):
            shutil.copy2(path + suf, path)
            print("restored", path)
    for p in (THEME, LUA):
        if os.path.exists(p):
            os.remove(p)
    subprocess.run([os.path.expanduser("~/.local/bin/rice-wm"), "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)


def main(argv):
    if len(argv) < 2:
        die(__doc__)
    cmd = argv[1]
    if cmd == "state":
        state()
        return
    os.makedirs(DIR, exist_ok=True)
    lk = open(DIR + "/.rofi.lock", "w")
    fcntl.flock(lk, fcntl.LOCK_EX)
    if cmd == "apply":
        c = load()
        save(c)
        apply(c, reload_hypr=True)
    elif cmd == "set":
        if len(argv) < 4:
            die("usage: rice-rofi set KEY VALUE")
        setkey(argv[2], argv[3])
    elif cmd == "reset":
        if os.path.exists(CFG):
            os.remove(CFG)
        apply(load())
    elif cmd == "restore":
        restore()
    else:
        die(__doc__)


if __name__ == "__main__":
    main(sys.argv)
